{
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/api/p?slug=:slug"
    }
  ],
  "redirects": [
    {
      "source": "/solo",
      "destination": "/game/world3d/?solo=1",
      "permanent": false
    },
    {
      "source": "/game/world",
      "destination": "/game/world3d/",
      "permanent": false
    },
    {
      "source": "/game/world/",
      "destination": "/game/world3d/",
      "permanent": false
    },
    {
      "source": "/game/world/index.html",
      "destination": "/game/world3d/",
      "permanent": false
    },
    {
      "source": "/game/city",
      "destination": "/game/world3d/?area=city",
      "permanent": false
    },
    {
      "source": "/game/city/",
      "destination": "/game/world3d/?area=city",
      "permanent": false
    },
    {
      "source": "/game/city/index.html",
      "destination": "/game/world3d/?area=city",
      "permanent": false
    }
  ],
  "functions": {
    "api/p.js": {
      "includeFiles": "{p/index.html,supabase-config.js}"
    }
  }
}
